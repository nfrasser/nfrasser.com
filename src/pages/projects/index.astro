---
import { CollectionEntry, getCollection } from "astro:content"
import Card from "../../components/Card.astro"
import Layout from "../../layouts/Layout.astro"

const allProjects: CollectionEntry<"projects">[] = await getCollection("projects")
---

<Layout title="projects by nfrasser" url="/projects/">
	<h1>projects</h1>
	<ul class="main-grid" role="list">
		{
			allProjects.map((project) => (
				<Card href={`/projects/${project.id}/`} title={project.data.title} body={project.data.summary} />
			))
		}
	</ul>
</Layout>
